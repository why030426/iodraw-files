<mxfile host="app.diagrams.net" modified="2026-05-12T10:00:00.000Z" agent="draw.io" version="21.0.0" type="device">
  <diagram id="ray-architecture" name="Ray集群结构与任务调度流程">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- 标题 -->
        <mxCell id="title" value="图2-1  Ray集群结构与任务调度流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="Client (驱动程序)&lt;br&gt;1. 提交任务  &amp;nbsp;&amp;nbsp; 7. 返回结果" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="110" y="100" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Head Node 大框 -->
        <mxCell id="head-node-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;dashed=0;align=left;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=5;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="430" y="90" width="500" height="200" as="geometry" />
        </mxCell>
        <mxCell id="head-label" value="Head Node (主节点)&lt;br&gt;控制面（Control Plane）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="435" y="95" width="300" height="40" as="geometry" />
        </mxCell>

        <!-- GCS -->
        <mxCell id="gcs" value="GCS&lt;br&gt;(Global Control Store)&lt;br&gt;全局控制存储&lt;br&gt;(集群元数据管理)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="470" y="140" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- Scheduler -->
        <mxCell id="scheduler" value="Scheduler&lt;br&gt;(调度器)&lt;br&gt;任务调度与资源管理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="720" y="155" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- Worker Nodes 大框 -->
        <mxCell id="workers-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;dashed=0;verticalAlign=top;align=left;spacingTop=5;spacingLeft=5;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="1200" height="240" as="geometry" />
        </mxCell>
        <mxCell id="workers-label" value="Worker Nodes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="105" y="385" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- Worker 1 -->
        <mxCell id="worker1" value="Worker Node 1&lt;br&gt;(工作节点1)&lt;br&gt;3. 执行任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="140" y="420" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="objstore1" value="Object Store&lt;br&gt;(本地对象存储)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="520" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Worker 2 -->
        <mxCell id="worker2" value="Worker Node 2&lt;br&gt;(工作节点2)&lt;br&gt;3. 执行任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="400" y="420" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="objstore2" value="Object Store&lt;br&gt;(本地对象存储)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="410" y="520" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- Worker N -->
        <mxCell id="workerN" value="Worker Node N&lt;br&gt;(工作节点N)&lt;br&gt;3. 执行任务" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="1000" y="420" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="objstoreN" value="Object Store&lt;br&gt;(本地对象存储)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1010" y="520" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- 省略号表示更多 Worker -->
        <mxCell id="dots" value="..." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="450" width="100" height="30" as="geometry" />
        </mxCell>

        <!-- 数据面通信标签 -->
        <mxCell id="data-plane-label" value="数据面通信&lt;br&gt;(任务数据、对象传输)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#6c8ebf;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="350" width="160" height="30" as="geometry" />
        </mxCell>

        <!-- 控制面通信标签 -->
        <mxCell id="control-plane-label" value="控制面通信&lt;br&gt;(元数据、调度信息)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="600" y="310" width="160" height="30" as="geometry" />
        </mxCell>

        <!-- 流程说明注解框 -->
        <mxCell id="flow-notes" value="&lt;b&gt;流程说明：&lt;/b&gt;&lt;br&gt;1. Client提交任务到Head节点&lt;br&gt;2. Scheduler根据资源与策略将任务调度到合适的Worker节点&lt;br&gt;3. Worker执行任务&lt;br&gt;4. 数据通过Object Store在节点间传输&lt;br&gt;5. 执行结果存入Object Store&lt;br&gt;6. 结果返回给Client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;spacingTop=5;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="680" width="360" height="140" as="geometry" />
        </mxCell>

        <!-- 箭头：1. Client提交任务到Head -->
        <mxCell id="arrow1" value="1" style="endArrow=classic;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="310" y="140" as="sourcePoint" />
            <mxPoint x="430" y="140" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 箭头：2. Scheduler调度到Worker (控制面) -->
        <mxCell id="arrow2" value="2" style="endArrow=classic;html=1;fillColor=#dae8fc;strokeColor=#b85450;strokeWidth=2;dashed=1;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="805" y="235" as="sourcePoint" />
            <mxPoint x="805" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 从 Scheduler 到各 Worker 的调度指示线 (控制面) -->
        <mxCell id="arrow2a" value="" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="805" y="380" as="sourcePoint" />
            <mxPoint x="220" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow2b" value="" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="805" y="380" as="sourcePoint" />
            <mxPoint x="480" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow2c" value="" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="805" y="380" as="sourcePoint" />
            <mxPoint x="1080" y="420" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 数据面：Worker执行后数据通过Object Store传输 (蓝色) -->
        <mxCell id="data1_2" value="4" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="290" y="560" as="sourcePoint" />
            <mxPoint x="410" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="data2_N" value="4" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#000000;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="550" y="560" as="sourcePoint" />
            <mxPoint x="1010" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 箭头：6. 结果返回Client -->
        <mxCell id="arrow6" value="6" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#000000;startArrow=none;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="430" y="200" as="sourcePoint" />
            <mxPoint x="210" y="200" as="targetPoint" />
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- 虚线框标注控制面和数据面范围 -->
        <mxCell id="plane-note" value="控制面 = Head Node，数据面 = Worker Object Stores 间通信" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="800" y="680" width="300" height="30" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
