        <mxCell id="reg-arrow-terminal" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" edge="1">
          <mxGeometry x="220" y="170" as="sourcePoint" />
