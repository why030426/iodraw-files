        <mxCell id="cloud-node" value="云端节点&lt;br&gt;tier_cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="1" vertex="1">
