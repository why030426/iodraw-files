          <mxGeometry x="280" y="360" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="scheduler-box" value="调度器 Scheduler" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=top;align=center;spacingTop=5;" parent="1" vertex="1">
          <mxGeometry x="430" y="130" width="220" height="240" as="geometry" />
        </mxCell>
        <mxCell id="label-index" value="标签索引&lt;br&gt;tier: {terminal, edge, cloud}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;" parent="1" vertex="1">
          <mxGeometry x="450" y="170" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="matching" value="标签匹配 &amp; 队列管理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="450" y="240" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="queue-edge" value="边缘队列" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="450" y="300" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="queue-cloud" value="云端队列" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="550" y="300" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="task-submit" value="任务提交&lt;br&gt;resources={&#39;tier&#39;: &#39;edge&#39;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="750" y="180" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="submit-arrow" value="指定资源标签" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;fontColor=#6c8ebf;" parent="1" edge="1">
          <mxGeometry x="750" y="210" as="sourcePoint" />
          <mxGeometry x="650" y="210" as="targetPoint" />
        </mxCell>
        <mxCell id="submit-note" value="" style="endArrow=none;html=1;strokeColor=none;" parent="1" edge="1">
          <mxGeometry as="geometry" />
        </mxCell>
        <mxCell id="route-terminal" value="路由至终端节点" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#82b366;exitX=0;exitY=0.2;exitDx=0;exitDy=0;" parent="1" edge="1">
          <mxGeometry x="430" y="200" as="sourcePoint" />
          <mxGeometry x="220" y="170" as="targetPoint" />
        </mxCell>
        <mxCell id="route-edge" value="路由至边缘节点" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#82b366;" parent="1" edge="1">
          <mxGeometry x="430" y="250" as="sourcePoint" />
          <mxGeometry x="220" y="250" as="targetPoint" />
        </mxCell>
        <mxCell id="route-cloud" value="路由至云端节点" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#82b366;" parent="1" edge="1">
          <mxGeometry x="430" y="330" as="sourcePoint" />
          <mxGeometry x="220" y="330" as="targetPoint" />
        </mxCell>
        <mxCell id="result-arrow" value="执行结果" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;fontColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" edge="1">
          <mxGeometry x="220" y="380" as="sourcePoint" />
          <mxGeometry x="750" y="380" as="targetPoint" />
        </mxCell>
        <mxCell id="result-label" value="结果返回" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="450" y="390" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flow-note" value="&lt;b&gt;流程说明&lt;/b&gt;&lt;br&gt;1. 节点启动时标注自定义资源标签（tier_edge, tier_cloud 等）并注册到调度器标签索引。&lt;br&gt;2. 提交任务时可指定所需资源标签，如 {tier: &#39;edge&#39;}。&lt;br&gt;3. 调度器根据标签匹配目标节点层，若空闲则直接分发；若繁忙则任务进入该层等待队列。&lt;br&gt;4. 任务执行完成后结果返回给 Client。&lt;br&gt;5. 系统通过此机制实现层级感知调度，保障推理阶段精确递送至指定层级。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;fontSize=11;spacingTop=5;spacingLeft=10;" parent="1" vertex="1">
          <mxGeometry x="80" y="440" width="580" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legend-box" value="图例" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;verticalAlign=top;align=left;fontSize=11;fontStyle=1;spacingTop=5;spacingLeft=5;" parent="1" vertex="1">
          <mxGeometry x="750" y="440" width="250" height="120" as="geometry" />
        </mxCell>
