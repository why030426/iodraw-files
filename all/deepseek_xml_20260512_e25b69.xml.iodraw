<mxfile host="www.iodraw.com" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36 Edg/148.0.0.0" version="24.7.17">
  <diagram id="label-scheduling-simple" name="图2-2 标签调度机制图（简化版）">
    <mxGraphModel dx="3042" dy="1267" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="图2-2  标签调度机制图（简化版）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="250" y="20" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="task" value="&lt;b&gt;任务提交&lt;/b&gt;&lt;br&gt;指定资源标签&lt;br&gt;{&quot;tier&quot;: &quot;edge&quot;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="60" y="180" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;调度器&lt;/b&gt;&lt;br&gt;根据标签匹配节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="340" y="190" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="arrow1" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="240" y="220" as="sourcePoint" />
          <mxGeometry x="340" y="220" as="targetPoint" />
        </mxCell>
        <mxCell id="arrow1-label" value="提交任务" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="270" y="200" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="terminal-node" value="&lt;b&gt;终端节点&lt;/b&gt;&lt;br&gt;标签：tier_terminal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="640" y="100" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="edge-node" value="&lt;b&gt;边缘节点&lt;/b&gt;&lt;br&gt;标签：tier_edge" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="640" y="190" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cloud-node" value="&lt;b&gt;云端节点&lt;/b&gt;&lt;br&gt;标签：tier_cloud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="640" y="280" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="arrow-term" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;dashed=1;" parent="1" edge="1">
          <mxGeometry x="520" y="220" as="sourcePoint" />
          <mxGeometry x="640" y="130" as="targetPoint" />
        </mxCell>
        <mxCell id="arrow-edge" style="endArrow=classic;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;" parent="1" edge="1">
          <mxGeometry x="520" y="220" as="sourcePoint" />
          <mxGeometry x="640" y="220" as="targetPoint" />
        </mxCell>
        <mxCell id="arrow-cloud" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" parent="1" edge="1">
          <mxGeometry x="520" y="220" as="sourcePoint" />
          <mxGeometry x="640" y="310" as="targetPoint" />
        </mxCell>
        <mxCell id="match-note" value="按标签匹配&lt;br&gt;如 {tier: &quot;edge&quot;} → 边缘节点" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="560" y="360" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="queue-note" value="若目标层节点全忙，任务在该层队列等待" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;fontSize=11;fontColor=#b85450;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="640" y="370" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;调度逻辑：&lt;/b&gt; 客户端提交任务时携带资源标签 → 调度器根据标签寻找匹配节点 → 若有空闲节点则直接执行，若全忙则排队。" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;fontSize=11;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="60" y="440" width="600" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
