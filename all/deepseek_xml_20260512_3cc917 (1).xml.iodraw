        <mxCell id="Fuxm8fl5zzEz5uIL4x9W-20" value="用于卸载策略" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="630" y="490" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="Fuxm8fl5zzEz5uIL4x9W-21" value="&lt;b&gt;流程说明：&lt;/b&gt; ① 各节点部署 Node Exporter，暴露 /metrics 指标。 ② Prometheus Server 定期 Pull 指标并存储为时间序列。 ③ 执行引擎通过 HTTP 调用 PromQL 查询接口，获取节点实时 CPU、内存等数据。 ④ 解析后的数据注入策略上下文，支撑卸载调度决策。" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" vertex="1" parent="1">
