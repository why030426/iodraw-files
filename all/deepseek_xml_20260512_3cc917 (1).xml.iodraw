        <mxCell id="Fuxm8fl5zzEz5uIL4x9W-15" value="&lt;b&gt;执行引擎&lt;/b&gt;&lt;br&gt;（本系统调度组件）&lt;br&gt;通过 HTTP 查询 PromQL&lt;br&gt;获取 CPU / 内存等&lt;br&gt;填充 available_nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1">
