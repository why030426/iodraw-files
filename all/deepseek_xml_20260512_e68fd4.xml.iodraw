          <mxGeometry x="60" y="100" width="880" height="180" as="geometry" />
        </mxCell>
        <mxCell id="terminal-node" value="终端节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="100" y="130" width="120" height="40" as="geometry" />
