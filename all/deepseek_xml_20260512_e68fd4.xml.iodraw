        <mxCell id="terminal-exporter" value="Node Exporter&lt;br&gt;/metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
