          <mxGeometry x="360" y="130" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="edge-exporter" value="Node Exporter&lt;br&gt;/metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="360" y="180" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cloud-node" value="云端节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="620" y="130" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cloud-exporter" value="Node Exporter&lt;br&gt;/metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="620" y="180" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dots" value="......" style="text;html=1;strokeColor=none;fillColor=none;fontSize=20;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="860" y="155" width="50" height="30" as="geometry" />
        </mxCell>
        <mxCell id="prom-server" value="&lt;b&gt;Prometheus Server&lt;/b&gt;&lt;br&gt;Pull 模型采集&lt;br&gt;时间序列存储&lt;br&gt;PromQL 查询引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="320" y="320" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pull-arrow1" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" parent="1" edge="1">
          <mxGeometry x="160" y="230" as="sourcePoint" />
          <mxGeometry x="380" y="320" as="targetPoint" />
        </mxCell>
        <mxCell id="pull-arrow2" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" parent="1" edge="1">
          <mxGeometry x="420" y="230" as="sourcePoint" />
          <mxGeometry x="430" y="320" as="targetPoint" />
        </mxCell>
        <mxCell id="pull-arrow3" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" parent="1" edge="1">
          <mxGeometry x="680" y="230" as="sourcePoint" />
          <mxGeometry x="480" y="320" as="targetPoint" />
        </mxCell>
        <mxCell id="pull-label" value="定期 Pull /metrics" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="400" y="280" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="executor" value="&lt;b&gt;执行引擎&lt;/b&gt;&lt;br&gt;（本系统调度组件）&lt;br&gt;通过 HTTP 查询 PromQL&lt;br&gt;获取 CPU / 内存等&lt;br&gt;填充 available_nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="320" y="460" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="query-arrow" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="460" y="410" as="sourcePoint" />
          <mxGeometry x="460" y="460" as="targetPoint" />
        </mxCell>
        <mxCell id="query-label" value="即时查询 API&lt;br&gt;（PromQL 查询）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="470" y="420" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="调度决策&lt;br&gt;（基于实时负载）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="700" y="480" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="decision-arrow" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=1.5;" parent="1" edge="1">
          <mxGeometry x="600" y="505" as="sourcePoint" />
          <mxGeometry x="700" y="505" as="targetPoint" />
        </mxCell>
        <mxCell id="decision-note" value="用于卸载策略" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;" parent="1" vertex="1">
          <mxGeometry x="630" y="490" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;流程说明：&lt;/b&gt; ① 各节点部署 Node Exporter，暴露 /metrics 指标。 ② Prometheus Server 定期 Pull 指标并存储为时间序列。 ③ 执行引擎通过 HTTP 调用 PromQL 查询接口，获取节点实时 CPU、内存等数据。 ④ 解析后的数据注入策略上下文，支撑卸载调度决策。" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="620" width="880" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
