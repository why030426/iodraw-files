        </mxCell>
        <mxCell id="target-area" value="&lt;b&gt;监控目标（节点）&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingTop=5;spacingLeft=5;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="280" height="260" as="geometry" />
        </mxCell>
        <mxCell id="terminal" value="终端节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="70" y="120" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="terminal-exporter" value="Node Exporter&lt;br&gt;📊 /metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="70" y="170" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge" value="边缘节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="70" y="235" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="edge-exporter" value="Node Exporter&lt;br&gt;📊 /metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="70" y="280" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cloud" value="云端节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="190" y="120" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cloud-exporter" value="Node Exporter&lt;br&gt;📊 /metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="190" y="170" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dots" value="......" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="190" y="270" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="prom-server" value="&lt;b&gt;Prometheus Server&lt;/b&gt;&lt;br&gt;定期 Pull 指标&lt;br&gt;时序数据库 (TSDB)&lt;br&gt;PromQL 查询引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="420" y="170" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pull-arrow1" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" parent="1" edge="1">
          <mxGeometry x="170" y="195" as="sourcePoint" />
          <mxGeometry x="420" y="195" as="targetPoint" />
        </mxCell>
        <mxCell id="pull-arrow2" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" parent="1" edge="1">
          <mxGeometry x="170" y="305" as="sourcePoint" />
          <mxGeometry x="420" y="235" as="targetPoint" />
        </mxCell>
        <mxCell id="pull-arrow3" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" parent="1" edge="1">
          <mxGeometry x="290" y="195" as="sourcePoint" />
          <mxGeometry x="420" y="215" as="targetPoint" />
        </mxCell>
        <mxCell id="pull-label" value="Pull /metrics" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="330" y="155" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="exec-engine" value="&lt;b&gt;执行引擎&lt;/b&gt;&lt;br&gt;（调度组件）&lt;br&gt;通过 HTTP 查询 PromQL&lt;br&gt;解析 CPU/内存数据&lt;br&gt;填充 available_nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="740" y="175" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="query-arrow" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="640" y="220" as="sourcePoint" />
          <mxGeometry x="740" y="220" as="targetPoint" />
        </mxCell>
        <mxCell id="query-label" value="PromQL 即时查询" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="650" y="200" width="90" height="20" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;调度决策&lt;/b&gt;&lt;br&gt;（基于实时负载）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="740" y="310" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="decision-arrow" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=1.5;" parent="1" edge="1">
          <mxGeometry x="850" y="265" as="sourcePoint" />
          <mxGeometry x="850" y="310" as="targetPoint" />
        </mxCell>
        <mxCell id="decision-note" value="支撑卸载策略" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="860" y="280" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="flow-note" value="&lt;b&gt;监控流程：&lt;/b&gt; ① 各节点Node Exporter暴露系统指标/metrics → ② Prometheus定期Pull数据，存储时序 → ③ 执行引擎通过PromQL查询实时负载 → ④ 负载数据注入策略，驱动卸载调度决策。" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="420" width="920" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
