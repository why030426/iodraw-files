<mxfile host="www.iodraw.com" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/148.0.0.0 Safari/537.36 Edg/148.0.0.0" version="24.7.17">
  <diagram id="prometheus-v2" name="Prometheus监控结构图(修正版)">
    <mxGraphModel dx="6042" dy="2367" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Prometheus 监控结构图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="300" y="20" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="target-box" value="&lt;b&gt;Ray 集群节点&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingTop=5;spacingLeft=5;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="60" y="100" width="250" height="220" as="geometry" />
        </mxCell>
        <mxCell id="terminal" value="终端节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="90" y="135" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="terminal-metrics" value="/metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="90" y="180" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="edge" value="边缘节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="90" y="235" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="edge-metrics" value="/metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="90" y="275" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="cloud" value="云端节点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="200" y="135" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="cloud-metrics" value="/metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
          <mxGeometry x="200" y="180" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Reporter Agent&lt;br&gt;（Ray 内置组件）&lt;br&gt;自动采集运行时指标" style="text;html=1;strokeColor=none;fillColor=none;fontSize=9;align=center;" parent="1" vertex="1">
          <mxGeometry x="100" y="150" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="prom-server" value="&lt;b&gt;Prometheus Server&lt;/b&gt;&lt;br&gt;Pull 模型采集&lt;br&gt;时序数据库&lt;br&gt;PromQL 查询引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="400" y="170" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pull-arrow" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1.5;dashed=1;" parent="1" edge="1">
          <mxGeometry x="310" y="220" as="sourcePoint" />
          <mxGeometry x="400" y="220" as="targetPoint" />
        </mxCell>
        <mxCell id="pull-label" value="定期 Pull /metrics" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="320" y="195" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="executor" value="&lt;b&gt;执行引擎&lt;/b&gt;&lt;br&gt;通过 PromQL 查询&lt;br&gt;获取 CPU/内存数据&lt;br&gt;填充 available_nodes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;" parent="1" vertex="1">
          <mxGeometry x="700" y="170" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="query-arrow" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry x="620" y="215" as="sourcePoint" />
          <mxGeometry x="700" y="215" as="targetPoint" />
        </mxCell>
        <mxCell id="query-label" value="PromQL 查询" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2" parent="1" vertex="1">
          <mxGeometry x="630" y="195" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;调度决策&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" parent="1" vertex="1">
          <mxGeometry x="740" y="300" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="decision-arrow" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=1.5;" parent="1" edge="1">
          <mxGeometry x="800" y="260" as="sourcePoint" />
          <mxGeometry x="800" y="300" as="targetPoint" />
        </mxCell>
        <mxCell id="flow-note" value="&lt;b&gt;监控流程：&lt;/b&gt; ① Ray 各节点 Reporter Agent 自动采集运行时指标并以 /metrics 暴露 → ② Prometheus Server 定期 Pull 数据并存储 → ③ 执行引擎通过 PromQL 查询实时负载 → ④ 数据注入策略上下文，驱动卸载调度决策。" style="text;html=1;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="400" width="860" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
